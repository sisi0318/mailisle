{
  "name": "mailisle",
  "version": "0.1.2",
  "description": "信屿 · MailIsle，本地存储的多邮箱客户端",
  "repository": { "type": "git", "url": "https://github.com/sisi0318/mailisle.git" },
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "engines": { "node": ">=22.12" },
  "scripts": {
    "dev": "tsx watch apps/server/src/index.ts --dev",
    "dev:web": "pnpm notices && pnpm --filter @mail/web dev",
    "notices": "pnpm licenses list --prod --json | tsx scripts/license-notices.ts",
    "build": "pnpm notices && pnpm --filter @mail/web build && tsup --config apps/server/tsup.config.ts",
    "start": "node apps/server/dist/index.js",
    "password": "node apps/server/dist/password.js",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
